+package io.github.unisim.ui;
+
+import com.badlogic.gdx.Gdx;
+import com.badlogic.gdx.InputMultiplexer;
+import com.badlogic.gdx.Screen;
+import com.badlogic.gdx.scenes.scene2d.Stage;
+import com.badlogic.gdx.scenes.scene2d.ui.Cell;
+import com.badlogic.gdx.scenes.scene2d.ui.Label;
+import com.badlogic.gdx.scenes.scene2d.ui.Skin;
+import com.badlogic.gdx.scenes.scene2d.ui.Table;
+import com.badlogic.gdx.utils.Align;
+import io.github.unisim.GameState;
+
+public class EventsScreen implements Screen {
+    private Stage stage;
+    private Table table;
+    private Skin skin;
+    private Label testLabel;
+    private Table eventsTable = new Table();
+    private Cell<Label> testLabelCell;
+    private boolean isVisible = false;
+
+    private InputMultiplexer inputMultiplexer = new InputMultiplexer();
+
+
+    public EventsScreen() {
+        stage = new Stage();
+        table = new Table();
+        skin = GameState.defaultSkin;
+
+        testLabel = new Label("Hello", skin);
+        eventsTable.center().center();
+        testLabelCell = eventsTable.add(testLabel).align(Align.center);
+
+        stage.addActor(eventsTable);
+
+    }
+
+    @Override
+    public void show() {
+
+    }
+
+    @Override
+    public void render(float delta) {
+        if (isVisible) {
+            // Draw the stage containing buttons
+            stage.act(delta);
+            stage.draw();
+        }
+    }
+
+    @Override
+    public void resize(int width, int height) {
+        stage.getViewport().update(width, height, true);
+
+    }
+
+    @Override
+    public void pause() {
+
+    }
+
+    @Override
+    public void resume() {
+        Gdx.input.setInputProcessor(inputMultiplexer);
+
+    }
+
+    @Override
+    public void hide() {
+
+    }
+
+    @Override
+    public void dispose() {
+        stage.dispose();
+        skin.dispose();
+    }
+
+    public void setVisible(boolean isVisible) {
+        this.isVisible = isVisible;
+    }
+}
